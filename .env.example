# Copy to .env before running `docker compose up`.
# These defaults are local-development credentials only. Replace every secret
# before exposing the stack outside your machine.

POSTGRES_DB=rustle
POSTGRES_USER=rustle
POSTGRES_PASSWORD=rustle_dev_password

# The e2e script uses the same password/host to force a presence TTL expiry.
KEYDB_PASSWORD=devkeydb

JWT_SECRET=dev-only-rustle-jwt-secret-change-me-0123456789abcdef
INTERNAL_API_TOKEN=dev-only-internal-token-change-me

# Local demo seed. Set SEED_DEMO=false to skip it.
SEED_DEMO=true
DEMO_EMAIL=demo@rustle.local
DEMO_PASSWORD=DemoPassw0rd!

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional build-time overrides. Leave empty for same-origin API and the current
# hostname with gateway port 4000.
# VITE_GATEWAY_URL=ws://localhost:4000/ws
# VITE_API_URL=http://localhost:8080
# Comma-separated ICE servers. Calls are peer-to-peer, so a TURN service is
# strongly recommended when participants are not on the same LAN.
# VITE_STUN_URLS=stun:stun.l.google.com:19302
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=

# Message media and profile image upload limit (25 MiB).
MAX_UPLOAD_BYTES=26214400
