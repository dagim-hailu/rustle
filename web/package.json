{
  "name": "rustle-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "proto:generate": "pbjs -t static-module -w es6 -o src/lib/chat.generated.js ../proto/chat.proto && pbts -o src/lib/chat.generated.d.ts src/lib/chat.generated.js",
    "e2e": "node scripts/e2e.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "call:smoke": "node scripts/call-smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.1.1",
    "@fontsource/noto-sans-ethiopic": "5.1.1",
    "@radix-ui/react-avatar": "1.1.1",
    "@radix-ui/react-dialog": "1.1.2",
    "@radix-ui/react-dropdown-menu": "2.1.2",
    "@radix-ui/react-tabs": "1.1.1",
    "@radix-ui/react-tooltip": "1.1.4",
    "@tanstack/react-virtual": "3.11.2",
    "i18next": "23.16.8",
    "immer": "10.1.1",
    "long": "5.2.3",
    "lucide-react": "0.468.0",
    "protobufjs": "7.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "15.1.3",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@types/react": "18.3.17",
    "@types/react-dom": "18.3.5",
    "@types/ws": "8.5.13",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "playwright-core": "1.49.1",
    "postcss": "8.4.49",
    "protobufjs-cli": "1.1.3",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "vite": "5.4.11",
    "vitest": "2.1.8",
    "ws": "8.18.0"
  },
  "engines": {
    "node": ">=18.18"
  }
}
